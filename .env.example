# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# Compose interpolates ${VAR} from this file; `web` also loads it wholesale.

# --- Postgres (the only variables the db container receives) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=website_45s_v3_prod

# --- Phoenix ---
# Generate with `mix phx.gen.secret`; never commit the generated value.
SECRET_KEY_BASE=CHANGE_ME_WITH_OUTPUT_FROM_MIX_PHX_GEN_SECRET
PHX_SERVER=true
DATABASE_HOST=db
# URL-encode the password before placing it in DATABASE_URL.
DATABASE_URL=ecto://postgres:URL_ENCODED_PASSWORD@db:5432/website_45s_v3_prod

# --- Third-party credentials: ALL REQUIRED and must be non-empty. ---
# config/runtime.exs reads them with System.fetch_env!/1, so the release
# refuses to boot if any is missing; an empty value boots but breaks
# Turnstile, email (SES) or Google sign-in at first use.
TURNSTILE_SECRET=CHANGE_ME_TO_THE_CLOUDFLARE_TURNSTILE_SECRET
AWS_ACCESS_KEY_ID=CHANGE_ME_SES_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_SES_SECRET_ACCESS_KEY
# AWS_SES_REGION=us-east-1
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_OAUTH_CLIENT_SECRET

# --- Gameplay analytics ---
# Comma-separated user ids (users.id) allowed into /admin (game logs,
# session replays). Find yours with: select id, username from users;
ADMIN_USER_IDS=CHANGE_ME
# Set to false to stop recording browser sessions on the game page.
# REPLAY_RECORDING=true

# --- certbot (docker-compose-nginx.yml only) ---
# Cloudflare API token with Zone:DNS:Edit and Zone:Zone:Read on the zone.
CF_API_TOKEN=CHANGE_ME_CLOUDFLARE_DNS_EDIT_TOKEN

# --- Image ---
# Pin deployments to the immutable digest printed by the "Build and Push"
# workflow's job summary, not the mutable latest tag.
APP_IMAGE=docker.io/thwar/fortyfives.net@sha256:REPLACE_WITH_RELEASE_IMAGE_DIGEST
