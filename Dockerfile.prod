# Builder: the same Elixir/OTP as .tool-versions, on Alpine 3.24.3.
FROM docker.io/hexpm/elixir:1.19.6-erlang-27.3.4.19-alpine-3.24.3@sha256:97f49c06689cae6411d430fa7658e2a7c8fb6b87951e85533c1a98dc85b6d043 AS build

# Install build dependencies
RUN apk update && \
    apk upgrade --no-cache && \
    apk add --no-cache \
      build-base \
      git \
      bash \
      sqlite

# Set the working directory inside the container
WORKDIR /app

# Install Hex and Rebar
RUN mix local.hex --force && \
    mix local.rebar --force

# Set environment to prod for building
ENV MIX_ENV=prod

# Fetch and compile dependencies first so the layer is cached until mix.lock
# or compile-time config changes.
COPY mix.exs mix.lock ./
RUN mix deps.get --only prod

RUN mkdir config
COPY config/config.exs config/prod.exs config/
RUN mix deps.compile

# Application source and static inputs
COPY priv priv
COPY lib lib
COPY assets assets

# Compile and digest static assets (tailwind + esbuild + phx.digest)
RUN mix assets.deploy

# Compile the application
RUN mix compile

# Runtime config is read at boot, so it goes in after compilation.
COPY config/runtime.exs config/

# Release overlays (bin/migrate, bin/server) and VM args
COPY rel rel

# Build the release
RUN mix release

# Runtime stage. Alpine version/digest must match the builder image's
# /etc/alpine-release (3.24.3) so the release's shared libraries line up.
FROM docker.io/library/alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# Install runtime dependencies (busybox wget is used by the HEALTHCHECK)
RUN apk update && \
    apk upgrade --no-cache && \
    apk add --no-cache \
      bash \
      openssl \
      ncurses-libs \
      sqlite \
      libstdc++

RUN addgroup -S app && adduser -S -G app -h /app app

# Set the working directory inside the container
WORKDIR /app

# Copy the release from the build stage
COPY --from=build --chown=app:app /app/_build/prod/rel/website_45s_v3 ./

# Copy the entrypoint script to the container
COPY --chown=app:app prod_entrypoint.sh /app/entrypoint.sh

# Make the script executable
RUN chmod +x /app/entrypoint.sh && mkdir /data && chown app:app /data

USER app

ENV PHX_SERVER=true

# Expose port 4000 for the app
EXPOSE 4000

# /healthz is served over plain HTTP; Plug.SSL excludes the 127.0.0.1 host
# from the HTTPS redirect (see config/prod.exs).
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://127.0.0.1:4000/healthz || exit 1

# Use the entrypoint script to run migrations and then start the Phoenix server
ENTRYPOINT ["/app/entrypoint.sh"]
