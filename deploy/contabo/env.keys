# Keys in /home/fortyfives/.env on the Contabo host, in file order, as of
# 2026-10-16. Values are secrets and live only on the host (and in
# backups/release-*/env.before there); this file only records which keys
# exist. See .env.example in the repo root for what each one means.

# Postgres-rollback profile only (the `db` service); the release ignores them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=website_45s_v3_prod

SECRET_KEY_BASE=
PHX_SERVER=true

# Unused since the SQLite cutover; DATABASE_PATH is set in docker-compose.yml.
DATABASE_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Not read by the release or by this host's certbot (which uses the HTTP
# webroot, not Cloudflare DNS).
CF_API_TOKEN=

# Kept so Turnstile can be turned on with TURNSTILE_ENABLED=true.
TURNSTILE_SECRET=

# /admin allowlist (users.id)
ADMIN_USER_IDS=

TURNSTILE_ENABLED=false
