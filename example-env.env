POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=website_45s_v3_prod
# Generate with `mix phx.gen.secret`; never commit the generated value.
SECRET_KEY_BASE=CHANGE_ME_WITH_OUTPUT_FROM_MIX_PHX_GEN_SECRET
PHX_SERVER=true
DATABASE_HOST=db
# URL-encode the password before placing it in DATABASE_URL.
DATABASE_URL=ecto://postgres:URL_ENCODED_PASSWORD@db:5432/website_45s_v3_prod
TURNSTILE_SECRET=CHANGE_ME_TO_THE_CLOUDFLARE_TURNSTILE_SECRET
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# certbot needs DNS:Edit, Zone:Read
CF_API_TOKEN=
# Pin deployments to an immutable image digest, not the mutable latest tag.
APP_IMAGE=docker.io/thwar/fortyfives.net@sha256:REPLACE_WITH_RELEASE_IMAGE_DIGEST
