<!DOCTYPE html>
<html lang="en" class="game-document">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <meta
      name="description"
      content="Play the 45s card game online for free. Forty Fives (45s) is a classic trick-taking card game. Create a table, invite friends, and play in your browser."
    />
    <meta name="robots" content="noindex" />
    <.live_title>
      {assigns[:page_title] || "Playing 45s | Forty Fives"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script
      nonce={assigns[:csp_nonce]}
      data-cfasync="false"
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/app.js"}
    >
    </script>
  </head>
  <body class="game-body">
    <div class="content">{@inner_content}</div>
  </body>
</html>
