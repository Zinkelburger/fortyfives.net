<div class="container home-container mx-auto px-3">
  <section class="home-hero py-9">
    <h1 class="text-6xl font-bold mb-5">Forty Fives</h1>
    <p class="text-2xl mb-5">The classic Merrimack Valley card game, online!</p>

    <div class="home-actions">
      <div class="home-action">
        <p class="text-xl">Play 45s online!</p>
        <.link navigate={~p"/play"} class="btn">Play Online</.link>
      </div>

      <div class="home-action">
        <p class="text-xl">Learn the rules of 45s</p>
        <.link navigate={~p"/learn"} class="btn">Learn 45s</.link>
      </div>
    </div>
  </section>

  <section class="py-8">
    <h2 class="text-3xl font-bold mb-4">About the Game</h2>
    <p class="text-lg mb-4">
      Forty Fives (45s) is a classic trick-taking card game. Teams of two bid,
      pick a trump suit, and try to be the first to reach 120 points. <br />
      <.link navigate={~p"/play"} class="underline">Play for free</.link>
      right in your browser, or
      <.link navigate={~p"/play?tab=private"} class="underline">create a private table</.link>
      and invite friends.
      Check out our <.link navigate={~p"/learn"} class="underline">rules page</.link>
      to get started.
    </p>
  </section>
</div>
